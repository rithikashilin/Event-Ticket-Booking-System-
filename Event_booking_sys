# **************** Ticket booking fn definition ****************
#--------------------------------------------------------------------
def book_ticket(uid):
    user_id=uid
    
    #**************** displays the events so admin can choose from the options ****************
    view_events(user_id) 
    
    #**************** Gets the Event ID from the user ****************
    try:
        e_id = int(input("Enter the Event ID: "))
    except ValueError:
        print("Invalid Event ID")
        return     
    #**************** Validate Event ID Before Updating ****************
    cursor.execute(
        "SELECT Event_id, Event_name, Event_date, Venue, Total_seats,Available_seats FROM events WHERE Event_id=?",
        (e_id,))
    result=cursor.fetchone()
    if result is None:
        print("Invalid Event ID")
        return
     
    #**************** Checks if there are seats available for booking ****************
    if not result[5]>0:
        print("Event Fully Booked!!")  
        return
         
    #**************** Gets the no of tickets from the user ****************
    try:
        tickets = int(input("Enter number of tickets: "))
    except ValueError:
        print("Invalid ticket count")
        return   
    #**************** Validate Ticket count Before booking ****************
    if tickets <= 0:
        print("Invalid ticket count")
        return
    if tickets > result[5]:
        print("Not enough seats available")
        return

    #**************** Booking Event  ****************
    cursor.execute("""
            INSERT INTO bookings(User_id, Event_id, Tickets)
            VALUES (?,?,?)
            """,(user_id,e_id,tickets))
        
    #**************** Updating available seat count in Events table  ****************
    cursor.execute("""
            UPDATE events SET Available_seats = Available_seats - ?
            WHERE Event_id=?
            """,(tickets,e_id))
    con.commit()
    print("Booking Successful!")
      



#--------------------------------------------------------------------
# **************** Ticket cancellation fn definition ****************
#--------------------------------------------------------------------
def cancel_bookings(uid):
    user_id=uid
    view_bookings(user_id)
    
    #**************** Gets the Event ID from the admin ****************
    try:
        b_id = int(input("Enter Booking ID: "))
    except ValueError:
        print("Invalid Booking ID")
        return
    cursor.execute(
        """SELECT b.Tickets, b.Event_id, e.Event_name 
        FROM bookings b 
        JOIN events e
        ON b.Event_id = e.Event_id
        WHERE b.Booking_id=? AND b.User_id=?
        """,(b_id,user_id))
    rec=cursor.fetchone()
    if rec is None:
        print("Invalid Booking ID")
        return
    
    e_id=rec[1]
    e_name=rec[2]
    ticket_count=rec[0]  
         
    #**************** Cancelling tickets ****************
    cursor.execute("""
        DELETE FROM bookings WHERE Booking_id=? AND User_id=?
        """,(b_id,user_id))
    
    #**************** Validating ticket Cancellation **************** 
    if cursor.rowcount == 0:
            print("Booking not found.")
            return
    
    #**************** Updating available seat count in Events table  ****************
    cursor.execute("""
        UPDATE events SET Available_seats = Available_seats + ?
        WHERE Event_id=?
        """,(ticket_count,e_id))
    
    
    con.commit()
    print("\n**************** Booking Cancelled Successfully!****************")
    print(f"Event Name : {e_name}")
    print(f"Tickets Cancelled : {ticket_count}")
    print("-"*30)
    
    
        
            



