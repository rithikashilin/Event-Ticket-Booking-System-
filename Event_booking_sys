# **************** Add event fn definition ****************
#--------------------------------------------------------------------
def add_event(m):
    Admin_id=m
    cursor.execute("SELECT Username FROM users WHERE User_id=?",(Admin_id,))
    
    record = cursor.fetchone()
    if not record:
        print("Admin not found")
        return

    Admin_name = record[0]
    while True:
       
        #**************** Gets the event details from the admin ****************
        Event_name=input("Enter the Event name: ")     
        Event_date = input("Enter Event Date (DD-MM-YYYY): ")
        Venue=input("Enter the Event Venue name: ")   
        try:
            Total_seats = int(input("Enter Total Seats: "))
        except ValueError:
            print("Please enter a valid number.")
            continue
        if Total_seats <= 0:
            print("Total seats must be greater than zero")
            continue
        try:
            cursor.execute("""
                SELECT 1
                FROM events
                WHERE Event_name = ?
                AND Event_date = ?
                AND Venue = ?
                """, (Event_name, Event_date, Venue))

            if cursor.fetchone():
                print("This event already exists!")
                continue
            cursor.execute("""
                INSERT INTO events(
                Event_name,
                Event_date,
                Venue,
                Total_seats,
                Available_seats,
                Event_addedby)
                VALUES (?,?,?,?,?,?)
                """,(Event_name, Event_date, Venue,Total_seats, Total_seats, Admin_name))

            con.commit()
            print("Event Added Successfully!")
        except sqlite3.IntegrityError:
            print("Event Name already exists.")

        choice=input("Do you want to add more events(Y/N)? ").upper()
        if choice=='N':
            break
        




