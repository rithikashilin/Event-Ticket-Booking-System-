#--------------------------------------------------------------------
# **************** Password setup ****************
#--------------------------------------------------------------------
def setup_password():
    import re
    password=input("Enter the password: ")
    
# **************** Validating password to make it strong****************      

    # Regex checks for uppercase, lowercase, digit, and symbol      
    Validate_password=r"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%&*])[A-Za-z\d!@#$%&*]{8,}$"
    if re.match(Validate_password, password):
            
# **************** Confirming password ****************
        def password_confirmation():
            try:
                confirm_password = input("Confirm your password: ")

                if password != confirm_password:
                    raise ValueError("Passwords don't match... Try Again")

                print("Password Setup Successful")
                return password
            except ValueError as e:
                print("Error:", e)
                return password_confirmation()
        return password_confirmation()

    else:
        print("Weak Password. Password must contain:")
        print("- At least 8 characters")
        print("- One uppercase letter")
        print("- One lowercase letter")
        print("- One digit")
        print("- One special character (!@#$%&*)")
        print("Try Again")
        return setup_password()




