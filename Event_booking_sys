#--------------------------------------------------------------------
# **************** Update events fn definition ****************
#--------------------------------------------------------------------
def update_events(a):
    admin_id=a
    cursor.execute("SELECT Username FROM users WHERE User_id=?",(admin_id,))
    u_name = cursor.fetchone()
    if not u_name:
        print("Admin not found")
        return
    admin_name = u_name[0]

    # **************** Displays Update/Cancel Events menu ****************    
    print("""**************** Update/Cancel Events Main Menu ****************\n
    1. Update Event\n
    2. Delete Event\n
    3. Go back to the main menu\n""")
    while(True):
        choice=input("Enter your choice: ")
        if choice == '1':
            
            #**************** displays the events so admin can choose from the options ****************
            view_events(admin_id) 

            #**************** Gets the Event ID from the admin ****************
            try:
                e_id = int(input("Enter Event ID: "))
            except ValueError:
                print("Please enter a valid numeric ID.")
                return
            
            #**************** Validate Event ID Before Updating ****************
            cursor.execute(
                "SELECT Event_id FROM events WHERE Event_id=?",(e_id,))
            if cursor.fetchone() is None:
                print("Invalid Event ID")
                continue

            # **************** Gets the updated details from the Admin ****************
            date=input("Enter Event Date (DD-MM-YYYY): ")
            
            #**************** Updates the Events table ****************                        
            cursor.execute("""
                UPDATE events set 
                Event_date=?,   
                Event_editedby=? WHERE Event_id=?
                """,(date,admin_name,e_id))   
            if cursor.rowcount > 0:
                con.commit()
                print("Event Updated Successfully!")
                break
            else:
                print("Event ID not found.")
                                
        elif choice == "2":
            
            #**************** displays the events so admin can choose from the options ****************
            view_events(admin_id) 
            
            #**************** Gets the Event ID from the admin ****************
            try:
                e_id = int(input("Enter the Event ID that needs to be deleted: "))
            except ValueError:
                print("Please enter a valid numeric ID.")
                continue
            #**************** Prevent Deleting Events With Bookings ****************
            cursor.execute("SELECT 1 FROM bookings WHERE Event_id=?",(e_id,))
            if cursor.fetchone():
                print("Cannot delete. Bookings exist for this event.")
                continue

            #**************** Deleting event ****************
            cursor.execute("""
                DELETE FROM events WHERE Event_id=?
                """,(e_id,))
            if cursor.rowcount > 0:
                con.commit()
                print("Event Deleted Successfully!")
            else:
                print("Event ID not found.")
            break
        elif choice == "3":
            break
        else:
            print("Invalid choice, please try again.")
            continue


    

