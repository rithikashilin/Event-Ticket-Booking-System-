    role = cursor.fetchone()
    if role is None:
        print("User not found")
        return
    r=role[0]
   
    if r=="User":
        #**************** Displays only the User's booking****************
        cursor.execute("""
            SELECT 
            b. Booking_id, 
            u. Username,
            e. Event_name, 
            e. Event_date, 
            e. Venue, 
            b. Tickets
            FROM bookings b
            JOIN users u
                ON b.User_id=u.User_id
